{
  "name": "@stakefit/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "pay-and-scan": "tsx src/scripts/pay-and-scan.ts",
    "pay-and-enter": "tsx src/scripts/pay-and-enter.ts",
    "test": "tsx --test src/*.test.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@stakefit/agent": "workspace:*",
    "@stakefit/cre": "workspace:*",
    "@stakefit/ens": "workspace:*",
    "@stakefit/health": "workspace:*",
    "@stakefit/hedera": "workspace:*",
    "@stakefit/ipfs": "workspace:*",
    "@stakefit/shared": "workspace:*",
    "@worldcoin/idkit-core": "^4.2.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
