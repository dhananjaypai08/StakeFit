# LLM (used by the agent locally and inside the CRE TEE via getSecret)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# The Graph
GRAPH_GATEWAY_API_KEY=
SUBGRAPH_STUDIO_DEPLOY_KEY=
STAKEFIT_SUBGRAPH_QUERY_URL=

# Sepolia contracts
SEPOLIA_RPC_URL=https://sepolia.infura.io
DEPLOYER_PRIVATE_KEY=0x
OBSERVATION_LOG_ADDRESS=
AUDIT_REGISTRY_ADDRESS=
ENS_AUDIT_RESOLVER_ADDRESS=
ENS_REGISTRAR_ADDRESS=
ENS_PARENT_NAME=stakefit.eth

# Chainlink CRE
CRE_API_KEY=
CRE_TARGET_CHAIN=ethereum-testnet-sepolia
STAKEFIT_RUBRIC=

# Hedera
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
HTS_CERTIFICATE_TOKEN_ID=
HCS_AUDIT_TOPIC_ID=

# IPFS via Pinata. Required for the report CID, ENS contenthash, and HTS certificate.
PINATA_JWT=

# Frontend
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8787
NEXT_PUBLIC_ORCHESTRATOR_WS_URL=ws://localhost:8787
# Free WalletConnect id so users can pay from HashPack: https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Orchestrator
PORT=8787
SCAN_PRICE_TINYBARS=10000
# Set false for the recorded x402 demo. true only for local Fitbit wiring.
SCAN_SKIP_PAYMENT=false
# Fee to unlock the written report after a scan
SCAN_CLAIM_PRICE_TINYBARS=10000
# Must differ from HEDERA_ACCOUNT_ID. Run: pnpm --filter @stakefit/hedera create-merchant
SCAN_PAYTO_ACCOUNT=

# StakeFit / Google Health (unverified GCP app, 100 test users, no CASA)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_HEALTH_WEBHOOK_SECRET=
SESSION_SECRET=change-me
ADMIN_EMAILS=
ADMIN_SECRET=
HEALTH_MOCK=false
PUBLIC_WEB_URL=http://localhost:3000
MARKET_REGISTRY_ADDRESS=

# Chainlink VRF v2.5 Sepolia (optional; adminResolve still works)
VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
VRF_SUBSCRIPTION_ID=
VRF_KEY_HASH=

# World Selfie Check (leave empty to skip and mint world:skipped)
WORLD_APP_ID=
WORLD_RP_ID=
